{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/register.sh\"",
            "timeout": 5,
            "statusMessage": "注册会话身份到共享注册表..."
          }
        ]
      }
    ]
  }
}
