{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.sh\"",
            "timeout": 5,
            "statusMessage": "Checking auto-scaffold toggle..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-decisions.sh\"",
            "timeout": 5,
            "statusMessage": "Capturing answered questions into DECISIONS.inbox..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/signal-reminder.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for decision/requirement signals..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-gate.sh\"",
            "timeout": 5,
            "statusMessage": "Checking pre-commit docs digestion status..."
          }
        ]
      }
    ]
  }
}
