{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.sh\"",
            "timeout": 5,
            "statusMessage": "检查 auto-scaffold 自动铺设开关..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-decisions.sh\"",
            "timeout": 5,
            "statusMessage": "采集拍板问答进 DECISIONS.inbox..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/signal-reminder.sh\"",
            "timeout": 5,
            "statusMessage": "检查决策/需求信号..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-gate.sh\"",
            "timeout": 5,
            "statusMessage": "检查 commit 前 docs 消化状态..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-sweep.sh\"",
            "timeout": 15,
            "statusMessage": "清理已合并的 worktree..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-sweep.sh\"",
            "timeout": 15,
            "statusMessage": "清理已合并的 worktree..."
          }
        ]
      }
    ]
  }
}
